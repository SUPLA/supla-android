<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="@dimen/settings_cell_height"
  android:background="@color/cell_bg_new"
  android:paddingLeft="@dimen/new_screen_margin"
  android:paddingRight="@dimen/new_screen_margin">

  <TextView
    android:id="@+id/settings_switch_label"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_alignParentStart="true"
    android:layout_centerVertical="true"
    android:layout_marginEnd="58dp"
    android:text="@string/settings_show_unavailable_channels"
    android:textAppearance="@style/AppTheme.TextAppearance.Body2" />

  <androidx.appcompat.widget.SwitchCompat
    android:id="@+id/settings_switch"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_alignParentEnd="true"
    android:layout_centerVertical="true"
    android:textSize="@dimen/default_text_size"
    app:thumbTint="@color/settings_switch_thumb"
    app:trackTint="@color/settings_switch_track" />

</RelativeLayout>
